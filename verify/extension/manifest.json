{
  "manifest_version": 3,
  "name": "Kovel Verifier",
  "version": "0.1.0",
  "description": "Checks that the code kovel.io serves you matches the build Kovel published to a public log, and holds your passphrase so it is released only into a verified build.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://rekor.sigstore.dev/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://kovel.io/*", "https://*.kovel.io/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kovel Verifier",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
